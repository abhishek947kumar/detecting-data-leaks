# ==============================================================================
# DLP CLOUD SHIELD - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=3000

# Environment Mode (development | production | test)
NODE_ENV=development

# AESX Master Key Secret (32-byte derived master cryptographic vault key)
# For production deployments, replace this with a secure random secret string!
AESX_SECRET=NexusCloud-AESX-MasterVault-Key-2026!#$

# Whitening Sub-Key Salt (Optional Custom Salt)
AESX_SALT=dlp-cloud-salt-vector
